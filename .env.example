# Copy to .env.local for local development. In Vercel, set these in Project Settings → Environment Variables.
DATABASE_URL=postgres://user:pass@host/db
# Neon direct connection for migrations (optional locally)
DATABASE_URL_UNPOOLED=
AUTH_SECRET=generate-with-openssl-rand-base64-48
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5-1
IMAGE_API_KEY=
IMAGE_PROVIDER=openai
# IMAGE_MODEL=gpt-image-1
# Private Vercel Blob store (OIDC). Leave empty locally to store files under .data/uploads.
BLOB_STORE_ID=
# First admin (used by `npm run db:seed`)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
