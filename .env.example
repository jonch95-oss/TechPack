# Copy to .env.local for local development. In Vercel, set these in Project Settings → Environment Variables.
DATABASE_URL=postgres://user:pass@host/db
AUTH_SECRET=generate-with-openssl-rand-base64-48
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
IMAGE_API_KEY=
BLOB_READ_WRITE_TOKEN=
# First admin (used by `npm run db:seed`)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
