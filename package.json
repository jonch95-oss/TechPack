    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "next": "16.3.8",
    "papaparse": "^5.7.0",
    "paper": "^0.12.18",
    "postgres": "^3.4.9",
    "potrace": "^2.1.8",
